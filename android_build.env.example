# Copy this file to android_build.env and keep that file untracked.
# Required: passwords for the existing Canto Android upload keystore.
KEYSTORE_PASSWORD=
KEY_PASSWORD=

# Optional. Defaults to ./upload-keystore.jks at the repository root.
# Relative paths are resolved from the repository root.
ANDROID_KEYSTORE_PATH=upload-keystore.jks

# To select a different env file, set ANDROID_BUILD_ENV_FILE in the shell
# before invoking scripts/build-android-release.sh. Do not put it in this file.
