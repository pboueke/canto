{
  "expo": {
    "name": "Canto",
    "slug": "canto",
    "version": "0.19.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "canto",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boueke.canto"
    },
    "android": {
      "package": "com.boueke.canto",
      "versionCode": 22,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Canto needs access to your photo library to attach images to journal pages.",
          "cameraPermission": "Canto needs camera access to take photos for journal pages."
        }
      ]
    ]
  }
}
