#!/bin/sh

# Sync version from CHANGELOG.md to package.json, app.json, and README.md
VERSION=$(grep -m1 '^## v' CHANGELOG.md | sed 's/^## v\([^ ]*\).*/\1/')
if [ -n "$VERSION" ]; then
  CURRENT=$(node -p "require('./package.json').version")
  if [ "$VERSION" != "$CURRENT" ]; then
    sed -i "s/\"version\": \"$CURRENT\"/\"version\": \"$VERSION\"/" package.json
    sed -i "s/\"version\": \"$CURRENT\"/\"version\": \"$VERSION\"/" app.json
    sed -i "s/version-$CURRENT-/version-$VERSION-/" README.md
    git add package.json app.json README.md
  fi
fi

npx lint-staged
